{
  "compilerOptions": {

    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2022",

    "lib": ["ES2022"],

    "types": ["node"],

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,

    "isolatedModules": true,

    "noUncheckedSideEffectImports": true,

    "moduleDetection": "force",

    "sourceMap": true

  },

  "include": [

    "src"

  ],

  "exclude": [

    "node_modules",
    "dist"

  ]

}